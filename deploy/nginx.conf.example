# NextPlane behind nginx with HTTPS. NextPlane listens on 127.0.0.1:12313 (plain HTTP);
# nginx terminates TLS. Set public_url = "https://plane.example.com" in config.toml.
server {
    listen 443 ssl http2;
    server_name plane.example.com;

    ssl_certificate     /etc/letsencrypt/live/plane.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/plane.example.com/privkey.pem;

    client_max_body_size 30m;   # uploads (25 MB by default) plus form overhead

    location / {
        proxy_pass http://127.0.0.1:12313;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        # WebSocket (live updates)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name plane.example.com;
    return 301 https://$host$request_uri;
}
