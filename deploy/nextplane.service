# systemd user unit (what `nextplane install` writes). Paths assume the default layout.
#   ~/.config/systemd/user/nextplane.service
#   systemctl --user daemon-reload && systemctl --user enable --now nextplane
#   loginctl enable-linger $USER   # keep it running after you log out (servers)
[Unit]
Description=NextPlane project management
After=network.target

[Service]
ExecStart=%h/.local/bin/nextplane --data %h/.nextplane serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
